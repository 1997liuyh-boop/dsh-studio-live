{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsh 工作室声明",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "icon", "description", "order", "entry", "capabilities", "compatibility"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1},
    "icon": {"type": "string"},
    "description": {"type": "string"},
    "order": {"type": "number"},
    "entry": {"type": "string", "pattern": "^/studio-projects/[a-z][a-z0-9-]*$"},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "compatibility": {"type": "object", "required": ["host", "runtime", "worktable"], "properties": {"host": {"type": "string"}, "runtime": {"type": "string"}, "worktable": {"type": "string"}}},
    "service": {"type": "object", "properties": {"windows": {"type": "string", "pattern": "^scripts/[a-z][a-z0-9-]*\\.ps1$"}}}
  },
  "additionalProperties": false
}
