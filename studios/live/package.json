{
  "name": "dsh-studio-live",
  "version": "0.1.1",
  "description": "AI 游戏直播：dsh 模型、弹幕队列、语音形象、OBS 与星露谷适配",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "static",
    "upstream",
    "patches",
    "app",
    "studio.json",
    "sources.json",
    "UPSTREAM.json",
    "adapters"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": "0.2.1-rc.2",
      "dshReleases": {
        "0.2.1-rc.2": "experimental"
      }
    }
  },
  "peerDependencies": {
    "dsh-studio-projects": "^0.5.0",
    "dsh-worktable": "^0.6.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "dsh-studio-projects": {
      "optional": true
    },
    "dsh-worktable": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs live"
  }
}
