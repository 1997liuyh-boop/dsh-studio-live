{
  "name": "dsh-studio-live",
  "version": "0.3.5",
  "description": "AI 游戏直播：dsh 模型、弹幕队列、语音形象、OBS 与星露谷适配",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2 || >=0.2.2-rc.1 <0.2.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE",
    "LIVE2D.md",
    "THIRD-PARTY-LIVE2D.txt",
    "static",
    "upstream",
    "patches",
    "app",
    "studio.json",
    "sources.json",
    "UPSTREAM.json",
    "adapters",
    "scripts/start.ps1"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "compatibility": {
      "dsh": "0.2.2-rc.1",
      "dshReleases": {
        "0.2.1-rc.2": "experimental",
        "0.2.2-rc.1": "experimental"
      }
    }
  },
  "peerDependencies": {
    "dsh-studio-projects": "^0.5.0",
    "dsh-worktable": "^0.6.0",
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "dsh-studio-projects": {
      "optional": true
    },
    "dsh-worktable": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-install.mjs"
  },
  "dependencies": {
    "mineflayer": "4.39.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1997liuyh-boop/dsh-studio-live.git"
  },
  "homepage": "https://github.com/1997liuyh-boop/dsh-studio-live#readme",
  "bugs": {
    "url": "https://github.com/1997liuyh-boop/dsh-studio-live/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "studio"
  ],
  "devDependencies": {
    "@pixi/unsafe-eval": "^6.5.10",
    "@pixiv/three-vrm": "^3.5.5",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "mineflayer": "^4.39.0",
    "msedge-tts": "^2.1.1",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10",
    "postcss": "^8.5.32",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwindcss": "4.3.0",
    "three": "^0.186.1",
    "typescript": "6.0.3",
    "ws": "^8.22.0"
  }
}
